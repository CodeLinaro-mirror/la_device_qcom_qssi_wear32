<!--
Default values of
rowHeight is 25%p
verticalGap is 6.127%p
keyLetterSize is 55%
-->
<Keyboard
    xmlns:latin="http://schemas.android.com/apk/res/com.android.inputmethod.latin"
    latin:touchPositionCorrectionData="@array/touch_position_correction_data_default"
    latin:rowHeight="22%p"
    latin:verticalGap="5%p"
    latin:keyLetterSize="@fraction/config_key_large_letter_ratio_lxx"
>
    <include
        latin:keyboardLayout="@xml/rows_symbols_shift" />
</Keyboard>
