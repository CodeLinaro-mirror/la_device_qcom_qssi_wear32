<merge
    xmlns:latin="http://schemas.android.com/apk/res/com.android.inputmethod.latin"
>
    <include
        latin:keyboardLayout="@xml/key_styles_common" />
    <include
        latin:keyboardLayout="@xml/key_styles_number" />
    <!-- in circular this row is assume 98% of diameter -->
    <Row>
        <Key
            latin:keyStyle="num1KeyStyle"
            latin:keyWidth="21%p" />
        <Key
            latin:keyStyle="num2KeyStyle"
            latin:keyWidth="21%p" />
        <Key
            latin:keyStyle="num3KeyStyle"
            latin:keyWidth="21%p" />
        <Key
            latin:keySpec="-"
            latin:moreKeys="+"
            latin:keyLabelFlags="hasPopupHint"
            latin:keyStyle="numKeyStyle"
            latin:backgroundType="functional"
            latin:keyWidth="16%p" />
        <Key
            latin:keyStyle="numPhoneToSymbolKeyStyle"
            latin:keyWidth="19%p" />
    </Row>
    <!-- in circular this row is using 97% of diameter -->
    <Row>
        <Key
            latin:keyStyle="num4KeyStyle"
            latin:keyXPos="1%p"
            latin:keyWidth="21%p" />
        <Key
            latin:keyStyle="num5KeyStyle"
            latin:keyWidth="21%p" />
        <Key
            latin:keyStyle="num6KeyStyle"
            latin:keyWidth="21%p" />
        <Key
            latin:keySpec="."
            latin:keyStyle="numKeyStyle"
            latin:backgroundType="functional"
            latin:keyWidth="17%p" />
        <Key
            latin:keyStyle="numSpaceKeyStyle"
            latin:keyWidth="17%p" />
    </Row>
    <!-- in circular this row is using 80% of diameter -->
    <Row>
        <Key
            latin:keyStyle="num7KeyStyle"
            latin:keyXPos="10%p"
            latin:keyWidth="21%p" />
        <Key
            latin:keyStyle="num8KeyStyle"
            latin:keyWidth="21%p" />
        <Key
            latin:keyStyle="num9KeyStyle"
            latin:keyWidth="21%p" />
        <Key
            latin:keyStyle="deleteKeyStyle"
            latin:keyWidth="17%p" />
    </Row>
    <!-- in circular this row is using 30% of diameter -->
    <Row>
        <!-- U+0030: "0" DIGIT ZERO -->
        <Key
            latin:keyStyle="num0KeyStyle"
            latin:keySpec="0 +|0"
            latin:moreKeys="!noPanelAutoMoreKey!,+"
            latin:keyXPos="30%p"
            latin:keyWidth="20%p" />
        <Key
            latin:keyStyle="enterKeyStyle"
            latin:keyWidth="20%p" />
    </Row>
</merge>
