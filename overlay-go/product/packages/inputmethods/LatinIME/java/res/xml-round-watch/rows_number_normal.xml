<merge
    xmlns:latin="http://schemas.android.com/apk/res/com.android.inputmethod.latin"
>
    <Row>
     <!-- in circular this row is using 95% of diameter -->
        <Key
            latin:keySpec="1"
            latin:keyXPos="12%p"
            latin:keyWidth="16%p"
            latin:keyStyle="numKeyStyle" />
        <Key
            latin:keySpec="2"
            latin:keyWidth="16%p"
            latin:keyStyle="numKeyStyle" />
        <Key
            latin:keySpec="3"
            latin:keyWidth="16%p"
            latin:keyStyle="numKeyStyle" />
        <Key
            latin:keySpec="-"
            latin:moreKeys="+"
            latin:keyLabelFlags="hasPopupHint"
            latin:keyStyle="numKeyStyle"
            latin:backgroundType="functional"
            latin:keyWidth="16%p" />
        <switch>
            <case
                latin:mode="date"
            >
                <Key
                    latin:keySpec="/"
                    latin:keyWidth="16%p"
                    latin:keyStyle="numKeyStyle" />
            </case>
            <case
                latin:mode="time"
            >
                <Key
                    latin:keySpec=":"
                    latin:keyWidth="16%p"
                    latin:keyStyle="numKeyStyle" />
            </case>
            <case
                latin:mode="datetime"
            >
                <Key
                    latin:keySpec="/ :|/"
                    latin:keyWidth="16%p"
                    latin:moreKeys="!noPanelAutoMoreKey!,:"
                    latin:keyStyle="numKeyStyle" />
            </case>
            <default>
                <Key
                    latin:keySpec="."
                    latin:keyWidth="16%p"
                    latin:keyStyle="numKeyStyle" />
            </default>
        </switch>
    </Row>
     <!-- in circular this row is using 95% of diameter -->
    <Row>
        <Key
            latin:keySpec="4"
            latin:keyXPos="12%p"
            latin:keyWidth="16%p"
            latin:keyStyle="numKeyStyle" />
        <Key
            latin:keySpec="5"
            latin:keyWidth="16%p"
            latin:keyStyle="numKeyStyle" />
        <Key
            latin:keySpec="6"
            latin:keyWidth="16%p"
            latin:keyStyle="numKeyStyle" />
        <switch>
            <case
                latin:mode="date"
            >
                <Key
                    latin:keySpec="."
                    latin:keyStyle="numKeyStyle"
                    latin:backgroundType="functional"
                    latin:keyWidth="16%p" />
            </case>
            <case
                latin:mode="time|datetime"
            >
                <Key
                    latin:keySpec="."
                    latin:moreKeys="!text/morekeys_am_pm"
                    latin:keyLabelFlags="hasPopupHint"
                    latin:keyStyle="numKeyStyle"
                    latin:backgroundType="functional"
                    latin:keyWidth="16%p" />
            </case>
            <default>
                <Key
                    latin:keySpec=","
                    latin:keyStyle="numKeyStyle"
                    latin:backgroundType="functional"
                    latin:keyWidth="16%p" />
            </default>
        </switch>
        <Key
            latin:keyStyle="numSpaceKeyStyle"
            latin:keyWidth="16%p" />
    </Row>
    <Row>
        <Key
            latin:keySpec="7"
            latin:keyXPos="12%p"
            latin:keyWidth="16%p"
            latin:keyStyle="numKeyStyle" />
        <Key
            latin:keySpec="8"
            latin:keyWidth="16%p"
            latin:keyStyle="numKeyStyle"/>
        <Key
            latin:keySpec="9"
            latin:keyWidth="16%p"
            latin:keyStyle="numKeyStyle" />
        <Key
            latin:keyStyle="deleteKeyStyle"
            latin:keyWidth="16%p" />
    </Row>
    <Row>
        <Key
            latin:keySpec="0"
            latin:keyXPos="28%p"
            latin:keyWidth="16%p"
            latin:keyStyle="numKeyStyle" />
        <Key
            latin:keyStyle="enterKeyStyle"
            latin:keyWidth="16%p" />
    </Row>
</merge>
