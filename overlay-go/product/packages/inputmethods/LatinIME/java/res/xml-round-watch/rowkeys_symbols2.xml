<merge
    xmlns:latin="http://schemas.android.com/apk/res/com.android.inputmethod.latin"
>
    <switch>
        <case
            latin:languageCode="fa"
        >
            <!-- U+066C: "٬" ARABIC THOUSANDS SEPARATOR
                 U+066B: "٫" ARABIC DECIMAL SEPARATOR -->
            <Key
                latin:keyXPos="6%p"
                latin:keySpec="&#x066C;"
                latin:keyWidth="11%p"
                latin:keyHintLabel="\@"
                latin:moreKeys="\@" />
            <Key
                latin:keySpec="&#x066B;"
                latin:keyWidth="11%p"
                latin:keyHintLabel="\#"
                latin:moreKeys="\#" />
        </case>
        <default>
            <Key
                latin:keyXPos="6%p"
                latin:keyWidth="11%p"
                latin:keySpec="\@" />
            <Key
                latin:keyWidth="11%p"
                latin:keySpec="\#" />
        </default>
    </switch>
    <Key
        latin:keyWidth="11%p"
        latin:keySpec="&amp;" />
    <!-- U+2013: "–" EN DASH
         U+2014: "—" EM DASH
         U+00B7: "·" MIDDLE DOT -->
    <Key
        latin:keySpec="-"
        latin:keyWidth="11%p"
        latin:moreKeys="_,&#x2013;,&#x2014;,&#x00B7;" />
    <Key
        latin:keySpec="+"
        latin:keyWidth="11%p"
        latin:moreKeys="!text/morekeys_plus" />
    <!-- U+2026: "…" HORIZONTAL ELLIPSIS -->
    <Key
        latin:keySpec="."
        latin:keyWidth="11%p"
        latin:moreKeys="&#x2026;" />
    <Key
        latin:keyWidth="11%p"
        latin:keySpec="!text/keyspec_comma" />
    <Key
        latin:keySpec="!text/keyspec_symbols_0"
        latin:keyWidth="11%p"
        latin:additionalMoreKeys="!text/additional_morekeys_symbols_0"
        latin:moreKeys="!text/morekeys_symbols_0" />
</merge>
