<merge
    xmlns:latin="http://schemas.android.com/apk/res/com.android.inputmethod.latin"
>
    <Key
        latin:keyWidth="11%p"
        latin:keySpec=":" />
    <Key
        latin:keyWidth="11%p"
        latin:keySpec="!text/keyspec_symbols_semicolon"
        latin:moreKeys="!text/morekeys_symbols_semicolon" />
    <Key
        latin:keyWidth="11%p"
        latin:keyStyle="currencyKeyStyle"
        latin:keyLabelFlags="followKeyLetterRatio" />
    <Key
        latin:keyWidth="11%p"
        latin:keyStyle="moreCurrency1KeyStyle" />
     <switch>
        <case
            latin:languageCode="fa"
        >
            <Key
                latin:keyWidth="11%p"
                latin:keySpec="!text/keyspec_left_double_angle_quote"
                latin:moreKeys="!text/morekeys_double_quote" />
            <Key
                latin:keyWidth="11%p"
                latin:keySpec="!text/keyspec_right_double_angle_quote"
                latin:moreKeys="!text/morekeys_single_quote" />
        </case>
        <default>
            <Key
                latin:keyWidth="11%p"
                latin:keySpec="&quot;"
                latin:moreKeys="!text/morekeys_double_quote" />
            <Key
                latin:keyWidth="11%p"
                latin:keySpec="\'"
                latin:moreKeys="!text/morekeys_single_quote" />
        </default>
    </switch>
    <Key
        latin:keyWidth="11%p"
        latin:keySpec="~" />
    <Key
        latin:keyWidth="11%p"
        latin:keySpec="`" />
    <Key
        latin:keyWidth="11%p"
        latin:keySpec="_" />
</merge>
