<merge
    xmlns:latin="http://schemas.android.com/apk/res/com.android.inputmethod.latin"
>
    <include
        latin:keyboardLayout="@xml/key_styles_common" />
    <Row
        latin:keyWidth="10%p"
    >
        <include
            latin:keyboardLayout="@xml/rowkeys_qwerty1" />
    </Row>
    <Row
        latin:keyWidth="9%p"
    >
        <include
            latin:keyXPos="5%p"
            latin:keyboardLayout="@xml/rowkeys_qwerty2" />
        <!-- adding shift key in alphabet mode to 2nd row
             making 10 keys in it also now. This makes ABC/symbols
             switcher and backspace key position uniform in all
             screens -->
        <Key
            latin:keyStyle="shiftKeyStyle" />
    </Row>
    <!-- remove shift and delete from 3rd row and add in 4th row
         in 4th row only keep space apart frmo shift, delete.
         , and period keys to be removed later -->
    <Row
        latin:keyWidth="9%p"
    >
        <include
            latin:keyboardLayout="@xml/rowkeys_qwerty3"
            latin:keyXPos="11%p" />
        <Key
            latin:keyStyle="deleteKeyStyle"
            latin:keyWidth="13%p"
            latin:visualInsetsLeft="1%p" />
    </Row>
    <Row>
         <Key
            latin:keyStyle="toSymbolKeyStyle"
            latin:keyXPos="20%p"
            latin:keyWidth="11%p"
            latin:visualInsetsRight="1%p" />
        <include
            latin:keyWidth="11%p"
            latin:keyboardLayout="@xml/key_comma"/>
        <include
            latin:keyboardLayout="@xml/key_space_symbols"/>
        <Key
            latin:keyStyle="enterKeyStyle"
            latin:keyWidth="11%p"
            latin:visualInsetsLeft="1%p" />
    </Row>
</merge>
