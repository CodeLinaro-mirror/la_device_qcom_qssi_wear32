<resources>
<!-- *************** Circular Display Changes *******************
     Base values taken from frameworks/base/core/res/res/values/
     dimens_material.xml
-->
    <!-- Preference activity side margins. was 0dp in values/dimens_material.xml -->
    <dimen name="preference_screen_side_margin_material">@dimen/select_dialog_padding_start_material</dimen>

    <!-- Preference fragment padding, sides . was 0dp in values/dimens_material.xml -->
    <dimen name="preference_fragment_padding_side_material">@dimen/select_dialog_padding_start_material</dimen>
    <!-- Preference activity bottom margin. changed to see last item fully
         in round display changes from 0dp to 72dp -->
    <dimen name="preference_screen_bottom_margin">72dp</dimen>

    <!-- Default height of an action bar. was 56dp in values/dimens_material.xml -->
    <dimen name="action_bar_default_height_material">48dp</dimen>
    <!-- Default start padding of an action bar. was 0dp in values/dimens_material.xml -->
    <dimen name="action_bar_default_padding_start_material">108dp</dimen>
    <!-- Default end padding of an action bar. was 0dp in values/dimens_material.xml -->
    <dimen name="action_bar_default_padding_end_material">108dp</dimen>
    <!-- Default content inset of an action bar. was 16dp in values/dimens_material.xml -->
    <dimen name="action_bar_content_inset_material">0dp</dimen>
    <!-- Vertical padding around action bar icons. was 16dp in values/dimens_material.xml -->
    <dimen name="action_bar_icon_vertical_padding_material">4dp</dimen>

    <!-- Padding to add to the start of the overflow action button.  was 6dp -->
    <dimen name="action_bar_overflow_padding_start_material">0dp</dimen>
    <!-- Padding to add to the end of the overflow action button. was 10dp -->
    <dimen name="action_bar_overflow_padding_end_material">0dp</dimen>
    <!-- was 48dp in values/dimens_material.xml -->
    <dimen name="action_button_min_width_material">40dp</dimen>
    <!-- was 48dp in values/dimens_material.xml -->
    <dimen name="action_button_min_height_material">40dp</dimen>

  </resources>
