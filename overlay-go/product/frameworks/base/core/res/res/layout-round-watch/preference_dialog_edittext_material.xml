<!-- Layout used as the dialog's content View for EditTextPreference. -->

<!-- *************** Circular Display Changes *******************
     Base file has been copied from /frameworks/base/core/res/res
     /layout/preference_dialog_edittext_material.xml. Only change is done
     to modify paddingStart and paddingEnd of the LinearLayout -->

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="48dp"
    android:layout_marginBottom="48dp"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:id="@+id/edittext_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/select_dialog_padding_start_material"
        android:paddingEnd="@dimen/select_dialog_padding_start_material"
        android:orientation="vertical">

        <TextView
            android:id="@+id/message"
            android:layout_marginBottom="48dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="?attr/textColorSecondary"
            style="?attr/textAppearanceSmall" />

    </LinearLayout>

</ScrollView>
