<resources>
    <!-- Keyguard component -->
    <string name="config_keyguardComponent" translatable="false">com.qualcomm.qti.apps.watchsystemui/com.qualcomm.qti.apps.watchsystemui.keyguard.WatchKeyguardService</string>
    <!-- SystemUi service component -->
    <string name="config_systemUIServiceComponent" translatable="false">com.qualcomm.qti.apps.watchsystemui/com.qualcomm.qti.apps.watchsystemui.WatchSystemUIService</string>
    <!-- screen shot service component -->
    <string name="config_screenshotServiceComponent" translatable="false">com.qualcomm.qti.apps.watchsystemui/com.qualcomm.qti.apps.watchsystemui.screenshot.ScreenshotService</string>
    <!-- SystemUi usb debugging component -->
    <string name="config_customAdbPublicKeyConfirmationComponent">com.qualcomm.qti.apps.watchsystemui/com.qualcomm.qti.apps.watchsystemui.usb.UsbDebuggingActivity</string>
    <!-- SystemUi MediaProjectionPermission component -->
    <string name="config_mediaProjectionPermissionDialogComponent" translatable="false">com.qualcomm.qti.apps.watchsystemui/com.qualcomm.qti.apps.watchsystemui.mediaprojection.MediaProjectionPermissionActivity</string>
    <!-- data limit component -->
    <string name="config_networkOverLimitComponent" translatable="false">com.qualcomm.qti.apps.watchsystemui/com.qualcomm.qti.apps.watchsystemui.network.WatchNetworkOverLimitActivity</string>

    <!-- Controls the double tap power button gesture to trigger a target action.
        0: Gesture is disabled
        1: Launch camera mode, allowing the user to disable/enable the double tap power gesture
           from launching the camera application.
        2: Multi target mode, allowing the user to select one of the targets defined in
           config_doubleTapPowerGestureMultiTargetDefaultAction and to disable/enable the double
           tap power gesture from triggering the selected target action.
    -->
    <integer name="config_doubleTapPowerGestureMode">1</integer>

    <!-- Flags enabling default window features. See Window.java -->
    <bool name="config_defaultWindowFeatureOptionsPanel">true</bool>
</resources>
